# ------------------------------------------------------------------
# Zemiki store - environment variables
# Copy this file to `.env` for local development, and set the same
# variables in the Railway dashboard (Variables tab) for production.
# ------------------------------------------------------------------

# Server
PORT=3000
NODE_ENV=development

# PostgreSQL connection string.
# On Railway, add a PostgreSQL plugin and reference its DATABASE_URL.
# Locally, e.g. postgres://user:pass@localhost:5432/zemiki
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zemiki

# Set to "true" to force SSL (Railway needs SSL). If unset, SSL is
# auto-enabled whenever NODE_ENV=production.
PGSSL=

# Auth / security - CHANGE THESE to strong random values in production
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# Store branding / contact
STORE_NAME=Zemiki
# WhatsApp number in international format WITHOUT + or spaces, e.g. 94771234567
WHATSAPP_NUMBER=94770000000
# Public base URL of the deployed site (used for payment return URLs).
# Leave blank locally; set to your Railway domain in production.
PUBLIC_BASE_URL=

# Shipping (LKR) - initial defaults; editable later in Admin -> Settings
SHIPPING_FLAT_LKR=350
FREE_SHIPPING_OVER_LKR=15000

# Email via Google Apps Script (order invoices + offer emails).
# Leave blank to run without email; see docs/apps-script/README.md to enable.
APPSCRIPT_URL=
APPSCRIPT_SECRET=

# ------------------------------------------------------------------
# Payment providers - leave blank to run in safe TEST/SANDBOX mode.
# Paste real merchant credentials to go live.
# ------------------------------------------------------------------

# KOKO (Buy Now Pay Later)
KOKO_MERCHANT_ID=
KOKO_API_KEY=
KOKO_BASE_URL=https://ipg.koko.lk

# Mintpay (Buy Now Pay Later)
MINTPAY_MERCHANT_ID=
MINTPAY_API_KEY=
MINTPAY_BASE_URL=https://api.mintpay.lk

# PayHere (cards / bank)
PAYHERE_MERCHANT_ID=
PAYHERE_SECRET=
# Set to "true" to use PayHere sandbox endpoint even with credentials set
PAYHERE_SANDBOX=true
